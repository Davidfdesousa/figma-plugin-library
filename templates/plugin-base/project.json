{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@plugin-factory/template-plugin-base",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx scripts/build.ts",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build-css"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    }
  }
}
